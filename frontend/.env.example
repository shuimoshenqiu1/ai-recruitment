# ============================================================
# AI招聘匹配系统 - 前端环境变量
# 复制为 .env 后修改实际值
# ============================================================

# API后端地址
VITE_API_BASE_URL=http://localhost:8000

# API路径前缀
VITE_API_PREFIX=/api/v1

# 应用名称
VITE_APP_TITLE=AI招聘匹配系统

# 文件上传大小限制 (bytes)
VITE_MAX_UPLOAD_SIZE=20971520

# WebSocket地址 (实时通知)
VITE_WS_URL=ws://localhost:8000/ws

# 环境标识
VITE_ENVIRONMENT=development

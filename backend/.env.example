# ============================================================
# AI招聘匹配系统 - 后端环境变量
# 复制为 .env 后修改实际值
# ============================================================

# ---------- 应用配置 ----------
APP_NAME=AI招聘匹配系统
ENVIRONMENT=development          # development | staging | production
DEBUG=true

# ---------- 安全 ----------
SECRET_KEY=your-super-secret-key-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24小时
ALGORITHM=HS256

# ---------- 数据库 (PostgreSQL + pgvector) ----------
DATABASE_URL=postgresql+asyncpg://recruitment:recruitment_dev_2024@localhost:5432/recruitment

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- CORS ----------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------- 文件上传 ----------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520            # 20MB (bytes)
ALLOWED_EXTENSIONS=["pdf","docx","doc","txt"]

# ---------- LLM 配置 ----------
DEFAULT_LLM_PROVIDER=openai       # openai | azure | local
LLM_REQUEST_TIMEOUT=30
LLM_MAX_RETRIES=3

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Azure OpenAI (可选)
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# 本地模型 (可选, 兼容OpenAI API)
LOCAL_LLM_API_BASE=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen2.5:14b

# ---------- Celery ----------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---------- 向量嵌入 ----------
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

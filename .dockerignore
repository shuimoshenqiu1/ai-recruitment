# ============================================================
# AI招聘匹配系统 - Docker构建排除规则
# ============================================================

# Git
.git
.gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# 环境变量（不应进入镜像）
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
venv/
.venv/

# Node
node_modules/
npm-debug.log*
.pnpm-store/

# Build artifacts
frontend/dist/
frontend/build/

# Docker
docker-compose*.yml
Dockerfile

# Docs
README.md
docs/
*.md

# Uploads (runtime data)
uploads/

# Tests (not needed in prod image)
tests/
**/tests/

# CI/CD
.github/

# OS
.DS_Store
Thumbs.db

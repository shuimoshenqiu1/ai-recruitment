# AI招聘匹配系统 - 环境变量配置
# 复制此文件为 .env 并填入实际值
# docker compose 会自动加载根目录的 .env 文件

# ==================== 基础配置 ====================
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-production
# 生产环境请用: openssl rand -hex 32

# ==================== 数据库 ====================
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=recruitment_dev_2024
DATABASE_URL=postgresql+asyncpg://recruitment:recruitment_dev_2024@postgres:5432/recruitment

# ==================== Redis ====================
REDIS_URL=redis://redis:6379/0

# ==================== LLM配置 ====================
# 至少配置一个LLM提供商，用于简历解析和智能匹配

# 默认提供商: openai / deepseek / moonshot / zhipu / anthropic / ollama
DEFAULT_LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- DeepSeek (更便宜) ---
# DEFAULT_LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- Kimi (Moonshot) ---
# DEFAULT_LLM_PROVIDER=moonshot
# MOONSHOT_API_KEY=sk-your-moonshot-key
# MOONSHOT_MODEL=moonshot-v1-8k
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1

# --- 智谱 GLM ---
# DEFAULT_LLM_PROVIDER=zhipu
# ZHIPU_API_KEY=your-zhipu-key
# ZHIPU_MODEL=glm-4
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# --- Anthropic Claude ---
# DEFAULT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_MODEL=claude-3-sonnet-20240229

# --- Ollama (本地免费) ---
# DEFAULT_LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen2

# ==================== 文件上传 ====================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520
# 20MB = 20 * 1024 * 1024

# ==================== CORS ====================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost"]

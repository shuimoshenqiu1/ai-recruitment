# ============================================================
# AI招聘匹配系统 - 生产环境变量模板
# 复制为 .env.prod 并填入真实值
# ⚠️ 永远不要将此文件（填入真实值后）提交到版本控制
# ============================================================

# ---------- PostgreSQL ----------
POSTGRES_DB=recruitment
POSTGRES_USER=recruitment
POSTGRES_PASSWORD=<CHANGE_ME_strong_random_password>

# ---------- 应用密钥 ----------
SECRET_KEY=<CHANGE_ME_at_least_32_chars_random_string>

# ---------- LLM ----------
OPENAI_API_KEY=sk-<your-key>
